#==============================================================================
# Dados
#
# A árvore data/ é versionada apenas na forma (via .gitkeep); o conteúdo não.
#==============================================================================
# Base original (creditcard.csv ~150 MB, acima do limite de 100 MB do GitHub).
# Baixar de: https://www.kaggle.com/datasets/mlg-ulb/creditcardfraud
data/raw/*
!data/raw/.gitkeep

# Artefatos gerados pelo pipeline (folds externos e internos)
data/processed/*
!data/processed/.gitkeep

# Formatos pesados de dados intermediários
*.parquet
*.feather
*.h5
*.hdf5
*.npy
*.npz

#==============================================================================
# Modelos serializados
#==============================================================================
*.pkl
*.pickle
*.joblib
*.model
*.bin

#==============================================================================
# Python
#==============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Ambientes virtuais
.venv/
venv/
env/
ENV/
.conda/

# Ferramentas de teste e lint
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Variáveis de ambiente / credenciais (ex.: chave da API do Kaggle)
.env
*.env
kaggle.json

#==============================================================================
# LaTeX (artefatos de compilação em docs/monografia)
#==============================================================================
*.aux
*.bbl
*.blg
*.brf
*.fdb_latexmk
*.fls
*.idx
*.ilg
*.ind
*.lof
*.log
*.lot
*.nav
*.out
*.snm
*.synctex.gz
*.toc
*.xdv

# O PDF compilado da monografia E versionado (docs/monografia/main.pdf),
# para que a versao mais recente do texto fique disponivel no repositorio.

# Ferramentas locais nao versionadas
.tools/

#==============================================================================
# Bibliografia (docs/references)
#
# Os PDFs sao material de editoras: cerca de 48 MB cuja redistribuicao em geral
# nao e permitida. As notas de leitura em citations/ e o indice README.md sao
# versionados; os arquivos em si, nao.
#==============================================================================
docs/references/articles/**/*.pdf

# Configuracao local do vault do Obsidian (especifica da maquina)
.obsidian/

#==============================================================================
# Rascunhos (docs/scratch)
#
# O texto oficial e o LaTeX em docs/monografia. A pasta docs/scratch guarda
# rascunhos, anotacoes de trabalho e scripts auxiliares de apoio, que mudam a
# cada sessao de escrita e nao compoem o repositorio.
#==============================================================================
docs/scratch/
*.docx
*.doc
~$*.docx

#==============================================================================
# Editores e IDEs
#==============================================================================
.vscode/
.idea/
*.swp
*.swo
*~

#==============================================================================
# Sistema operacional / OneDrive
#==============================================================================
Thumbs.db
ehthumbs.db
desktop.ini
Desktop.ini
$RECYCLE.BIN/
.DS_Store
*.tmp
~$*
